-- ============================================================
-- 5. VINCULAR PERMISSÕES AOS GRUPOS
-- ============================================================

-- 5.1 ADMINISTRADOR: tudo de segurança
INSERT INTO GroupPermission (groupId, permissionId)
SELECT g.groupId, p.permissionId
FROM EntityGroup g
CROSS JOIN Permission p
WHERE g.code = 'ADMINISTRADOR'
  AND (
      p.code LIKE 'PERMISSION_USER%'
      OR p.code LIKE 'PERMISSION_GROUP%'
  );

-- 5.2 SECRETARIO: tudo de secretaria
INSERT INTO GroupPermission (groupId, permissionId)
SELECT g.groupId, p.permissionId
FROM EntityGroup g
CROSS JOIN Permission p
WHERE g.code = 'SECRETARIO'
  AND p.code LIKE 'PERMISSION_SECRETARIA%';

-- 5.3 AUXILIAR_SECRETARIA: leitura e relatórios de secretaria
INSERT INTO GroupPermission (groupId, permissionId)
SELECT g.groupId, p.permissionId
FROM EntityGroup g
CROSS JOIN Permission p
WHERE g.code = 'AUXILIAR_SECRETARIA'
  AND p.code IN (
      'PERMISSION_SECRETARIA_MEMBRO_READ',
      'PERMISSION_SECRETARIA_MEMBRO_REPORT'
  );

-- 5.4 ASSISTENTE_SECRETARIA: criação e atualização de membros
INSERT INTO GroupPermission (groupId, permissionId)
SELECT g.groupId, p.permissionId
FROM EntityGroup g
CROSS JOIN Permission p
WHERE g.code = 'ASSISTENTE_SECRETARIA'
  AND p.code IN (
      'PERMISSION_SECRETARIA_MEMBRO_CREATE',
      'PERMISSION_SECRETARIA_MEMBRO_UPDATE'
  );

-- 5.5 RELATORIOS_SECRETARIA: apenas relatórios de secretaria
INSERT INTO GroupPermission (groupId, permissionId)
SELECT g.groupId, p.permissionId
FROM EntityGroup g
CROSS JOIN Permission p
WHERE g.code = 'RELATORIOS_SECRETARIA'
  AND p.code = 'PERMISSION_SECRETARIA_MEMBRO_REPORT';

