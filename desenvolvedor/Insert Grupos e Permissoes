-- ============================================================
-- 3. VINCULAR PERMISSÕES AOS GRUPOS
-- ============================================================

-- SUPER_ADMIN: herda todos os grupos (não precisa de permissões diretas se usar herança)
-- ADMINISTRADOR: tudo de segurança
INSERT INTO GroupPermission (groupId, permissionId)
SELECT g.groupId, p.permissionId
FROM EntityGroup g
CROSS JOIN Permission p
WHERE g.code = 'ADMINISTRADOR'
  AND p.code LIKE 'PERMISSION_USER%'
   OR p.code LIKE 'PERMISSION_GROUP%';



-- ASSISTENTE SECRETARIA:
INSERT INTO GroupPermission (groupId, permissionId)
SELECT g.groupId, p.permissionId
FROM EntityGroup g
CROSS JOIN Permission p
WHERE g.code = 'ASSISTENTE_SECRETARIA'
  AND p.code LIKE 'PERMISSION_SECRETARIA_MEMBRO_DELETE'
   OR p.code LIKE 'PERMISSION_SECRETARIA_MEMBRO_READ';


-- ASSISTENTE FINANCEIRO:
INSERT INTO GroupPermission (groupId, permissionId)
SELECT g.groupId, p.permissionId
FROM EntityGroup g
CROSS JOIN Permission p
WHERE g.code = 'ASSISTENTE_FINANCEIRO'
  AND p.code LIKE 'PERMISSION_TESOURARIA_MOVIMENTO_FINANCEIRO_CREATE'
   OR p.code LIKE 'PERMISSION_TESOURARIA_MOVIMENTO_FINANCEIRO_READ'
   OR p.code LIKE 'PERMISSION_TESOURARIA_MOVIMENTO_FINANCEIRO_UPDATE'
   OR p.code LIKE 'PERMISSION_TESOURARIA_MOVIMENTO_FINANCEIRO_DELETE';



