/* Removendo banco se existir */
DROP DATABASE IF EXISTS saac_security;

/* Criando Banco de Dados */
CREATE DATABASE IF NOT EXISTS saac_security
  DEFAULT CHARACTER SET utf8mb4 
  COLLATE utf8mb4_unicode_ci;

/* Selecionando Banco */
USE saac_security;

/*========================================================*/
/*                    TABELA USUARIO                     */
/*========================================================*/
CREATE TABLE Usuario(
  usuarioId BIGINT PRIMARY KEY AUTO_INCREMENT,
  nome VARCHAR(150) NOT NULL,
  email VARCHAR(150) NOT NULL,
  senha VARCHAR(255) NOT NULL,
  ativo BOOLEAN NOT NULL DEFAULT TRUE,
  unidadeId BIGINT NOT NULL,
  tipoEscopo ENUM('LOCAL', 'GLOBAL') NOT NULL,
  createdAt DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updatedAt DATETIME DEFAULT NULL ON UPDATE CURRENT_TIMESTAMP,
  deletedAt DATETIME DEFAULT NULL,
  modifiedBy BIGINT DEFAULT NULL,

  CONSTRAINT uk_usuarios_email UNIQUE (email),
  INDEX idx_usuarios_unidade (unidadeId)

) ENGINE=InnoDB;


/*========================================================*/
/*                   REFRESH TOKEN                        */
/*========================================================*/
CREATE TABLE RefreshToken (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    token VARCHAR(500) NOT NULL UNIQUE,
    userId BIGINT NOT NULL,
    expiresOn DATETIME NOT NULL,
    revoked BOOLEAN NOT NULL DEFAULT FALSE,
    createdAt DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_refreshtoken_usuario FOREIGN KEY (userId) REFERENCES Usuario(usuarioId)
) ENGINE=InnoDB;

CREATE INDEX idx_refresh_token_user ON RefreshToken(userId);




